#include <winres.h>

1 RT_MANIFEST "@OST_MANIFEST@"
101 ICON "@OST_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,5,4,1
PRODUCTVERSION  1,5,4,1
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenSteamTool"
            VALUE "FileDescription",  "@OST_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@OST_VERSION@"
            VALUE "InternalName",     "@OST_RC_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@OST_RC_INTERNAL_NAME@"
            VALUE "ProductName",      "OpenSteamTool"
            VALUE "ProductVersion",   "@OST_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
